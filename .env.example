# Copy to .env for local development. NEVER commit a real .env.
# In production these are injected from AWS Secrets Manager / SSM by user_data.sh.

# --- App ---
PROJECT_NAME=FaceByYou API
ENVIRONMENT=dev
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# --- Auth ---
JWT_SECRET=local-dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Required for Firebase email/password, login and reset requests. Do not commit its value.
# FIREBASE_WEB_API_KEY=
# FIREBASE_ADMIN_CREDENTIALS_PATH=

# --- CORS (comma-separated) ---
BACKEND_CORS_ORIGINS=*

# --- AWS ---
AWS_REGION=us-east-1

# --- S3 ---
S3_UPLOAD_BUCKET=facebyyou-uploads-dev
S3_PRESIGNED_URL_TTL_SECONDS=900
MAX_UPLOAD_SIZE_MB=50
# Scan uploads currently support JPEG only.
ALLOWED_UPLOAD_CONTENT_TYPES=image/jpeg

# --- DynamoDB ---
DYNAMODB_USERS_TABLE=facebyyou-users-dev
DYNAMODB_ANALYSES_TABLE=facebyyou-analyses-dev
DYNAMODB_SESSIONS_TABLE=facebyyou-sessions-dev
DYNAMODB_ADMIN_TABLE=facebyyou-admin-users-dev
DYNAMODB_AUDIT_TABLE=facebyyou-audit-logs-dev
DYNAMODB_IMAGES_TABLE=facebyyou-images-dev
DYNAMODB_ANALYTICS_TABLE=facebyyou-analytics-dev
# For local DynamoDB, point at the local container:
# DYNAMODB_ENDPOINT_URL=http://localhost:8001

# --- NVIDIA NIM ---
# NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL_NAME=nvidia/nemotron-nano-12b-v2-vl
NIM_TIMEOUT_SECONDS=45
NIM_IMAGE_URL_TTL_SECONDS=120

# --- Optional integrations ---
# OLLAMA_API_URL=http://localhost:11434/api/generate
# MIXPANEL_PROJECT_TOKEN=
